#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 50   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>



// Macros
#define MO_TOG(layer) &mo_tog layer layer // macro to trigger mo-tog on the same layer




// Global params
&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    // ---------- Hardware config ----------
    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        /* tap-ms = <100>; */
    };

    scroll_encoder_lr: scroll_encoder_lr {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };





    // --------- Behaviors ---------
    behaviors {
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            display-name = "layer mo-tog";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };




        td_ctl: td_ctl {
            compatible = "zmk,behavior-tap-dance";
            display-name = "CTRL/ESC tap dance";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&kp ESC>;
        };



    };






    // ---------- Keymap ----------
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E    &kp R    &kp T                  &mmv MOVE_UP               &kp Y  &kp U  &kp I       &kp O    &kp P     &kp BSPC
&td_ctl    &kp A  &kp S  &lt 2 D  &lt 3 F  &kp G   &mmv MOVE_LEFT &mkp MB1  &mmv MOVE_RIGHT  &kp H  &kp J  &kp K       &kp L    &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C    &kp V    &kp B   &mkp MB3       &mmv MOVE_DOWN             &kp N  &kp M  &kp COMMA   &kp DOT  &kp FSLH  &mt LSHFT SQT
                         &mt LGUI LG(SPACE)        &kp SPACE      MO_TOG(1)                  MO_TOG(2)     MO_TOG(3)   &kp RALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };






        layer_1 {
            display-name = "Num-Sym";
            bindings = <
&kp GRAVE &kp EXCL  &kp AT   &kp HASH  &kp DLLR  &kp PRCNT              &kp C_VOL_UP          &trans  &kp N7  &kp N8  &kp N9  &kp MINUS &trans
&kp TILDE &kp CARET &kp AMPS &kp ASTRK &kp MINUS &kp UNDER  &kp C_PREV  &kp C_PP  &kp C_NEXT  &trans  &kp N4  &kp N5  &kp N6  &kp PLUS  &trans
&trans &trans    &trans   &trans    &trans    &trans        &kp C_MUTE  &kp C_VOL_DN          &trans  &kp N1  &kp N2  &kp N3  &kp SLASH &kp ASTRK
                          &trans    &trans    &trans                                          &mo 4   &kp N0  &kp DOT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };





        layer_2 {
            display-name = "Nav-Ctrl";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans         &trans  &trans        &kp HOME  &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans &trans &trans  &trans  &kp LC(LEFT)  &kp END   &kp LC(RIGHT) &kp LC(BSPC)  &kp LC(DEL)
&trans  &trans  &trans  &trans  &trans  &bootloader &trans &trans         &trans  &trans        &trans    &trans        &trans        &trans
                        &trans  &trans  &mo 4                                     &trans        &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };



        layer_3 {
            display-name = "Nav";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans             &trans         &trans  &trans   &kp UP   &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans &trans &trans  &trans  &kp LEFT &kp DOWN &kp RIGHT &kp BSPC  &kp DEL
&trans  &trans  &trans  &trans  &trans  &bootloader &trans &trans         &trans  &trans   &trans   &trans    &trans    &trans
                        &trans  &trans  &trans                                    &trans   &trans   &trans
            >;

            sensor-bindings = <&scroll_encoder_lr>;
        };





        layer_4 {
            display-name = "Fn";
            bindings = <
&trans      &kp C_BRI_DN  &kp C_NEXT    &kp C_BRI_UP  &trans        &trans             &trans         &trans  &kp F7 &kp F8 &kp F9 &kp F10  &kp BSPC
&kp C_MUTE  &kp C_VOL_DN  &kp C_PP      &kp C_VOL_UP  &trans        &to 5       &trans &trans &trans  &trans  &kp F4 &kp F5 &kp F6 &kp F11  &kp GRAVE
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bootloader &trans &trans         &trans  &kp F1 &kp F2 &kp F3 &kp F12  &kp TILDE
                          &trans        &trans        &trans                                          &trans  &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };





        layer_5 {
            display-name = "Game";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T               &kp C_VOL_UP          &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td_ctl    &kp A  &kp S  &kp D  &kp F  &kp G   &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B   &kp C_MUTE  &kp C_VOL_DN          &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mt LSHFT SQT
                         &kp SPACE     &lt 6 SPACE         &mo 1                 &mo 2  &mo 3  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };


        layer_6 {
            display-name = "Game-alt";
            bindings = <
&kp TAB    &kp N1 &kp W  &kp N2  &kp N5  &kp N8              &kp C_VOL_UP          &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
&td_ctl    &kp A  &kp S  &kp N3  &kp N6  &kp N9  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LSHFT  &kp Z  &kp X  &kp N4  &kp N7  &kp N0  &kp C_MUTE  &kp C_VOL_DN          &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mt LSHFT SQT
                         &trans  &trans  &trans                                           &to 4  &to 0  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };
    };
};
